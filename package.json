{
  "name": "project-management-system",
  "version": "1.0.0",
  "description": "Full-stack Project Management System built with React, Vite, Node.js, Express, and MySQL.",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server run start",
    "build:client": "npm --prefix client run build",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm install --prefix server && npm install --prefix client && npm install --prefix mobile",
    "test": "npm --prefix server test && npm --prefix client test && npm --prefix mobile test",
    "test:unit": "npm --prefix server run test:unit",
    "test:integration": "npm --prefix server run test:integration",
    "test:coverage": "npm --prefix server run test:coverage",
    "check": "npm --prefix client run lint && npm --prefix client run build",
    "db:migrate": "npm --prefix server run db:migrate",
    "dev:mobile": "npm --prefix mobile start",
    "android:mobile": "npm --prefix mobile run android",
    "install:mobile": "npm --prefix mobile install",
    "test:mobile": "npm --prefix mobile test",
    "check:mobile": "npm --prefix mobile run check",
    "build:mobile": "npm --prefix mobile run bundle:android",
    "test:mobile-preview": "node server/scripts/mobilePreview.js"
  },
  "keywords": [
    "react",
    "vite",
    "express",
    "mysql",
    "project-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
