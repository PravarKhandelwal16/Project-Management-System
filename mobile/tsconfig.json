{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/**/*.js",
    "../shared/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
