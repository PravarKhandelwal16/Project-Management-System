# Android emulator. Physical phone: use your computer's LAN address instead.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# Public URL only. Never put JWT_SECRET, database or SMTP credentials here.

# Native Android builds only: local path (or EAS file-variable path) to Firebase config.
# Configure FCM service-account credentials in EAS, never EXPO_PUBLIC_*.
# GOOGLE_SERVICES_JSON=./google-services.json
