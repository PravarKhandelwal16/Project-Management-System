{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:email": "node scripts/testEmail.js",
    "test:reminders": "node scripts/testReminders.js",
    "migrate:access": "node scripts/migrateAccess.js",
    "test": "node scripts/runTests.js",
    "migrate:planning": "node scripts/migratePlanning.js",
    "test:unit": "node scripts/runTests.js unit",
    "test:integration": "node scripts/runTests.js integration",
    "test:coverage": "c8 node scripts/runTests.js",
    "migrate:release": "node scripts/migrateRelease.js",
    "db:migrate": "node scripts/migrateDatabase.js",
    "db:check": "node scripts/checkDatabase.js",
    "seed:demo": "node scripts/seedDemo.js",
    "bootstrap:admin": "node scripts/seedSuperAdmin.js",
    "docs:generate": "node scripts/generateApiDocs.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "c8": {
    "include": [
      "controllers/**/*.js",
      "services/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js",
      "jobs/**/*.js",
      "config/env.js"
    ],
    "exclude": [
      "tests/**",
      "scripts/**"
    ],
    "all": true,
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "reportsDirectory": "coverage"
  }
}
