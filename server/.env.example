# Copy to server/.env (root .env is also supported). Never commit the configured file.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_management
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_CA=
# Required even locally. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Exact origin; HTTPS is required in production. No trailing slash.
FRONTEND_URL=http://localhost:5173
# Empty for direct connections. Use loopback only behind a local trusted proxy.
TRUST_PROXY=
APP_TIMEZONE=Asia/Kolkata
REMINDER_CRON=0 8 * * *
SCHEDULER_ENABLED=true
# Empty SMTP_HOST disables outbound email; web notifications still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional separate test credentials; account needs CREATE/DROP only for test databases.
DB_NAME_TEST=project_management_test
# Demo seed requires NODE_ENV=development and DB_NAME ending in _demo.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
# Supply once to bootstrap a fresh installation; remove immediately afterward.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=

# Enable after EAS/FCM credentials are configured; runs on REMINDER_CRON above.
PUSH_ENABLED=false
# Optional Expo access token when enhanced push security is enabled. Backend secret only.
EXPO_ACCESS_TOKEN=
