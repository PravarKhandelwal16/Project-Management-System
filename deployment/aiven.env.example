# Replace only DB_* settings in server/.env. Preserve your JWT/app settings.
# Copy individual connection fields from the Aiven MySQL service Overview.
DB_HOST=your-service-host.aivencloud.com
DB_PORT=replace_with_aiven_service_port
DB_USER=avnadmin
DB_PASSWORD="replace_with_aiven_password"
DB_NAME=defaultdb
DB_POOL_SIZE=5
DB_SSL=true
# Local setup: absolute CA file path on your computer.
DB_SSL_CA=C:/Work/Project-Management-System/server/certs/aiven-ca.pem
# Render: replace DB_SSL_CA with /etc/secrets/aiven-ca.pem
